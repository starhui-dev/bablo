# Bablo local development defaults. Replace placeholders locally; never commit .env.
BABLO_ENV=development
BABLO_HTTP_ADDR=:8080
BABLO_LOG_LEVEL=info
BABLO_DATABASE_URL=
# Required in production for cross-instance login/MFA and runtime coordination.
# Redis remains rebuildable state; PostgreSQL is the business source of truth.
BABLO_REDIS_URL=
BABLO_CPA_CONFIG_PATH=
BABLO_READ_HEADER_TIMEOUT=5s
BABLO_READ_TIMEOUT=0s
BABLO_WRITE_TIMEOUT=0s
BABLO_IDLE_TIMEOUT=60s
BABLO_SHUTDOWN_TIMEOUT=15s
# Comma-separated CIDRs for direct reverse proxies allowed to supply X-Forwarded-For.
# Leave empty when Bablo is directly exposed; forwarded headers are then ignored.
BABLO_TRUSTED_PROXY_CIDRS=

# Web Session authentication. Generate a 32-byte key with:
#   openssl rand -base64 32
BABLO_WEB_ORIGIN=http://localhost:5173
BABLO_AUTH_ENCRYPTION_KEY=
BABLO_AUTH_KEY_VERSION=v1
BABLO_AUTH_SESSION_TTL=12h
BABLO_AUTH_COOKIE_DOMAIN=
BABLO_AUTH_REQUIRE_ADMIN_MFA=true
BABLO_AUTH_TOTP_ISSUER=Bablo

# Upstream Credential secrets. Optional outside production; rotate by loading
# old versions in BABLO_CREDENTIAL_ENCRYPTION_KEYS and setting the new current key.
# Format: version=standard-base64-key,version=standard-base64-key
BABLO_CREDENTIAL_ENCRYPTION_KEY=
BABLO_CREDENTIAL_ENCRYPTION_KEYS=
BABLO_CREDENTIAL_KEY_VERSION=v1

# Payment core. Stripe Checkout is the first production adapter; keep it
# disabled until its API key, endpoint signing secret, return URLs, and
# webhook endpoint are configured and sandbox-verified. The HMAC fixture is
# local/integration-only and is rejected in production.
BABLO_PAYMENT_ORDER_TTL=1h
BABLO_PAYMENT_EXPIRATION_INTERVAL=1m
BABLO_PAYMENT_WEBHOOK_TOLERANCE=5m
BABLO_PAYMENT_ALLOW_TEST_PROVIDERS=false
BABLO_PAYMENT_STRIPE_ENABLED=false
BABLO_PAYMENT_STRIPE_SECRET_KEY=
BABLO_PAYMENT_STRIPE_WEBHOOK_SECRET=
BABLO_PAYMENT_STRIPE_ACCOUNT_ID=
BABLO_PAYMENT_STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
BABLO_PAYMENT_STRIPE_CANCEL_URL=http://localhost:5173/billing
# Voucher creation is disabled unless a versioned AES-256 keyring is configured.
# Generate the current key with: openssl rand -base64 32
# Historical format: version=standard-base64-key,version=standard-base64-key
BABLO_PAYMENT_VOUCHER_ENABLED=false
BABLO_PAYMENT_VOUCHER_ENCRYPTION_KEY=
BABLO_PAYMENT_VOUCHER_ENCRYPTION_KEYS=
BABLO_PAYMENT_VOUCHER_KEY_VERSION=v1
BABLO_PAYMENT_FIXTURE_ENABLED=false
BABLO_PAYMENT_FIXTURE_MERCHANT_ID=
# Generate at least 32 bytes with: openssl rand -base64 32
BABLO_PAYMENT_FIXTURE_SECRET=

# Quota observations. Only CPA-public passive headers for supported providers
# are persisted; unknown/stale quota never becomes available capacity.
BABLO_QUOTA_ENABLED=true
BABLO_QUOTA_POLL_INTERVAL=1m
BABLO_QUOTA_PROBE_TIMEOUT=10s
BABLO_QUOTA_LEASE_TTL=30s
BABLO_QUOTA_MAX_BACKOFF=30m
BABLO_QUOTA_AUTH_BACKOFF=24h
BABLO_QUOTA_UNSUPPORTED_BACKOFF=1h
BABLO_QUOTA_MAX_AGE=2m
BABLO_QUOTA_BATCH_SIZE=32
BABLO_QUOTA_JITTER_RATIO=0.20

# Optional Scheduler quota filtering. Keep disabled until supported upstream
# headers have been observed in staging. Strict freshness rejects missing or
# stale snapshots; default false preserves unknown capacity as eligible.
BABLO_QUOTA_SCHEDULER_ENABLED=false
BABLO_QUOTA_SCHEDULER_WINDOW_KIND=provider_specific
BABLO_QUOTA_SCHEDULER_REQUIRE_FRESH=false

# deploy/compose.dev.yaml variables
POSTGRES_DB=bablo
POSTGRES_USER=bablo
POSTGRES_PASSWORD=replace-with-a-local-only-secret
