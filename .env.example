# Bablo local development defaults. Replace placeholders locally; never commit .env.
BABLO_ENV=development
BABLO_HTTP_ADDR=:8080
BABLO_LOG_LEVEL=info
BABLO_DATABASE_URL=
BABLO_REDIS_URL=
BABLO_READ_HEADER_TIMEOUT=5s
BABLO_READ_TIMEOUT=0s
BABLO_WRITE_TIMEOUT=0s
BABLO_IDLE_TIMEOUT=60s
BABLO_SHUTDOWN_TIMEOUT=15s

# deploy/compose.dev.yaml variables
POSTGRES_DB=bablo
POSTGRES_USER=bablo
POSTGRES_PASSWORD=replace-with-a-local-only-secret
